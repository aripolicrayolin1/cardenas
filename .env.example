# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - AgroTech Hidalgo
# =============================================================================
# Este archivo NO contiene secretos y SÍ se versiona.
#
# Para trabajar localmente:
#   1. Copia este archivo como `.env` en la raíz del proyecto.
#   2. Rellena los valores marcados como `cambiame`.
#
# Para produccion (Firebase App Hosting):
#   - NO pongas secretos reales en este archivo.
#   - Guardalos en Secret Manager y referencialos desde `apphosting.yaml`.
#
# El `.env` local nunca se sube al repositorio (ver .gitignore).

# =============================================================================
# IA GENERATIVA (Google Gemini via Genkit)
# =============================================================================
# Obtener en https://aistudio.google.com/app/apikey
# Solo se usa en el servidor: nunca la prefijes con NEXT_PUBLIC_.
GEMINI_API_KEY=cambiame

# =============================================================================
# ALERTAS POR TELEGRAM
# =============================================================================
# Token del bot, generado con @BotFather (comando /newbot o /revoke).
TELEGRAM_BOT_TOKEN=cambiame
# ID del chat o canal donde se publican las alertas comunitarias.
TELEGRAM_CHAT_ID=cambiame

# =============================================================================
# FIREBASE (cliente)
# =============================================================================
# Estos valores son publicos por diseño: viajan al navegador.
# La seguridad real vive en firestore.rules y database.rules.json,
# NO en ocultar estos valores.
NEXT_PUBLIC_FIREBASE_API_KEY=cambiame
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cambiame.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://cambiame-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cambiame
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cambiame.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=cambiame
NEXT_PUBLIC_FIREBASE_APP_ID=cambiame

# Pl@ntNet (OPCIONAL): identificación botánica especializada como segunda
# opinión en el diagnóstico por foto. Regístrate gratis en https://my.plantnet.org
# y pega tu llave aquí. Si se deja vacío, el diagnóstico usa solo Gemini.
PLANTNET_API_KEY=
